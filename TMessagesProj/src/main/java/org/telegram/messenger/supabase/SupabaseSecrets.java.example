package org.telegram.messenger.supabase;

public class SupabaseSecrets {
    // The seed for generating the decryption salt dynamically.
    // Replace this with your custom 64-bit random long seed (e.g. from a PRNG)
    public static final long XORSHIFT_SEED = 0L;
    
    // XOR Mask used to obfuscate URL and API key
    public static final byte XOR_MASK = 0;
    
    // Obfuscated bytes for the Supabase URL
    public static final byte[] URL_BYTES = new byte[] {
        // Add your XOR-obfuscated URL bytes here
    };
    
    // Obfuscated bytes for the Supabase Anon Key
    public static final byte[] KEY_BYTES = new byte[] {
        // Add your XOR-obfuscated Key bytes here
    };
}
